# Supabase project settings (Project Settings → API).
# Leave these empty to run the app in local DEMO MODE (data kept in browser localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public base URL used in QR codes, e.g. https://classroom-survey.pages.dev
# Defaults to the current browser origin when empty.
VITE_PUBLIC_SITE_URL=
