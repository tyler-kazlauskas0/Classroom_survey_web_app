# Copy this file to `.env` (which is git-ignored) and fill in your values.
# NEVER commit `.env`.
#
# Supabase → Project Settings → API (or "API Keys"):
#   VITE_SUPABASE_URL       Project URL, e.g. https://abcdefghijkl.supabase.co
#   VITE_SUPABASE_ANON_KEY  The *anon* (legacy) or *publishable* (sb_publishable_...) key.
#
# These two values are PUBLIC: they are bundled into the browser JavaScript and
# are safe only because Row Level Security protects the data.
# Do NOT put the service_role / secret (sb_secret_...) key or your database
# password in this file or anywhere in the frontend — the app refuses to start
# if it detects a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public base URL used in QR codes, e.g. https://classroom-survey.pages.dev
# Leave empty to use the current browser origin.
VITE_PUBLIC_SITE_URL=

# Leave empty. In local development the app runs in demo mode (data in the
# browser) when Supabase is not configured. Set to "true" only to allow demo
# mode in a production build.
VITE_ENABLE_DEMO=
